{
  "description": "Whether a price list is in the format price-list.schema.json describes. tests/pricing.test.ts holds the schema itself to every case, and each stack's own check of a list an operator saves must agree with it (the Laravel one: laravel/tests/Unit/PriceListFormatTest.php).",
  "cases": [
    {
      "name": "a minimal list",
      "list": {
        "id": "standard",
        "currency": "INR",
        "decimals": 2,
        "rounding": "half-up",
        "billingIncrementSeconds": 60,
        "rules": [
          {
            "id": "ai",
            "match": {
              "item": "component"
            },
            "price": {
              "markupPercent": "40"
            }
          }
        ]
      },
      "valid": true
    },
    {
      "name": "no rules at all",
      "list": {
        "id": "standard",
        "currency": "INR",
        "decimals": 2,
        "rounding": "half-up",
        "billingIncrementSeconds": 60,
        "rules": []
      },
      "valid": true
    },
    {
      "name": "extends another list",
      "list": {
        "id": "standard",
        "currency": "INR",
        "decimals": 2,
        "rounding": "half-up",
        "billingIncrementSeconds": 60,
        "rules": [
          {
            "id": "ai",
            "match": {
              "item": "component"
            },
            "price": {
              "markupPercent": "40"
            }
          }
        ],
        "extends": "base"
      },
      "valid": true
    },
    {
      "name": "a list of values to match",
      "list": {
        "id": "standard",
        "currency": "INR",
        "decimals": 2,
        "rounding": "half-up",
        "billingIncrementSeconds": 60,
        "rules": [
          {
            "id": "phone",
            "match": {
              "item": "call",
              "channel": [
                "telephony",
                "softphone"
              ]
            },
            "price": {
              "perMinute": "1.50"
            }
          }
        ]
      },
      "valid": true
    },
    {
      "name": "a full discount",
      "list": {
        "id": "standard",
        "currency": "INR",
        "decimals": 2,
        "rounding": "half-up",
        "billingIncrementSeconds": 60,
        "rules": [
          {
            "id": "free",
            "match": {
              "item": "component"
            },
            "price": {
              "markupPercent": "-100"
            }
          }
        ]
      },
      "valid": true
    },
    {
      "name": "a fee at a fixed price",
      "list": {
        "id": "standard",
        "currency": "INR",
        "decimals": 2,
        "rounding": "half-up",
        "billingIncrementSeconds": 60,
        "rules": [
          {
            "id": "rent",
            "match": {
              "item": "fee",
              "refKind": "rental"
            },
            "price": {
              "fixed": "120"
            }
          }
        ]
      },
      "valid": true
    },
    {
      "name": "no currency",
      "list": {
        "id": "standard",
        "decimals": 2,
        "rounding": "half-up",
        "billingIncrementSeconds": 60,
